  (text "SoC kill: the tamper MCU drives SOC_PWR_EN. The pull-down keeps the SoC off until supervisor firmware enables it, and a trip can cut SoC power in hardware."
    (at 299.72 99.06 0)
    (effects
      (font
        (size 1.27 1.27)
      )
      (justify left bottom)
    )
    (uuid "97d75ee1-0fbd-47af-958d-afb7835fd01d")
  )
